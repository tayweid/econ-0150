#!/usr/bin/env ruby
# Regenerate part-*.html and index.html from course-content.yml.
# Modeled on econ-0100/scripts/build-course. Home (econ-0150.html) and
# projects.html are static and not generated.
require 'yaml'
require 'pathname'

ROOT = Pathname.new(__dir__).parent
COURSE = YAML.safe_load(File.read(ROOT.join('course-content.yml')))

GENERATED = '<!-- Generated from course-content.yml by scripts/build-course. Do not edit this file directly. -->'

def escape(value)
  value.to_s.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;')
end

def icon_for(href)
  return 'fa-external-link' if href.include?('colab.research.google.com')
  return 'fa-file-text-o' if href.start_with?('data/')
  'fa-file-pdf-o'
end

def links_html(links)
  Array(links).map { |l|
    %(<a href="#{l['href']}" class="download-link" target="_blank"><i class="fa #{l['icon'] || icon_for(l['href'])}"></i> #{l['label']}</a>)
  }.join(' ')
end

def episode_html(ep, alt_override = nil)
  video = ep['video']
  l = []
  l << (video ? %(                    <div class="path-episode" data-video-id="#{video}">) : %(                    <div class="path-episode">))
  l << %(                        <div class="card-video">)
  if video
    l << %(                            <img src="https://img.youtube.com/vi/#{video}/maxresdefault.jpg" alt="#{alt_override || ep['name']} thumbnail">)
    l << %(                <div class="play-button">▶</div>)
  else
    l << %(                            <img alt="" class="placeholder-bg">)
  end
  l << %(                        </div>)
  l << %(                        <p class="path-name">#{ep['name']} <span class="path-desc">#{ep['desc']}</span></p>)
  l << %(                        <div class="path-links">#{links_html(ep['links'])}</div>) if ep['links']
  l << %(                    </div>)
  l.join("\n")
end

def step_html(st)
  l = []
  if st['kind'] == 'livestream'
    l << %(                <li class="path-step path-step-alt path-step-extra" data-video-id="#{st['video']}">)
    l << %(                    <span class="path-dot path-dot-alt" aria-hidden="true"></span>)
    l << %(                    <div>)
    l << %(                        <p class="path-name">#{st['name']} <span class="path-where">optional</span></p>)
    l << %(                    </div>)
    l << %(                <a class="path-thumb" href="https://www.youtube.com/watch?v=#{st['video']}" target="_blank"><img src="https://img.youtube.com/vi/#{st['video']}/maxresdefault.jpg" alt=""></a>)
    l << %(                </li>)
  else
    where = st['kind'] == 'exercise' ? 'in class' : 'home'
    l << %(                <li class="path-step">)
    l << %(                    <span class="path-dot" aria-hidden="true"></span>)
    l << %(                    <div>)
    l << %(                        <p class="path-name">#{st['name']} <span class="path-where">#{where}</span></p>)
    l << %(                    <p class="path-sub">#{st['sub']}</p>) if st['sub']
    l << %(                    <div class="path-links">#{links_html(st['links'])}</div>) if st['links']
    l << %(                    <p class="path-due">#{st['due']}</p>) if st['due']
    l << %(                    </div>)
    l << %(                <a class="path-thumb" href="https://www.youtube.com/watch?v=#{st['video']}" target="_blank"><img src="https://img.youtube.com/vi/#{st['video']}/maxresdefault.jpg" alt=""></a>) if st['video']
    l << %(                </li>)
  end
  l.join("\n")
end

def block_html(blk)
  bid = blk['id'].delete('.')
  l = []
  l << %(            <div class="block" id="part-#{bid}">)
  l << %(                <h1 class="subtitle">Block #{blk['id']} | #{blk['title']}</h1>)
  l << %(                <p class="block-description">#{blk['description']}</p>)
  l << %(                <div class="path">)
  l << episode_html(blk['episode'])
  l << %(                    <ol class="path-steps">)
  blk['steps'].each { |s| l << step_html(s) }
  l << %(                    </ol>)
  l << %(                </div>)
  l << %(            </div>)
  l.join("\n")
end

def checkpoint_html(me)
  n = me['number']
  demo = me['demo']
  l = []
  l << %(            <div class="block checkpoint" id="miniexam">)
  l << %(                <h1 class="subtitle">MiniExam #{n}</h1>)
  l << %(                <p class="block-description">#{me['description']}</p>)
  l << %(                <div class="path">)
  l << episode_html(demo, "Demo #{n}")
  l << %(                    <ol class="path-steps path-checkpoint">)
  l << %(                <li class="path-step">)
  l << %(                    <span class="path-dot" aria-hidden="true"></span>)
  l << %(                    <div>)
  l << %(                        <p class="path-name">Demo #{n} <span class="path-where">home</span></p>)
  l << %(                    <div class="path-links">#{links_html(me['demo_links'])}</div>)
  l << %(                    </div>)
  l << %(                </li>)
  l << %(                <li class="path-step path-step-checkpoint">)
  l << %(                    <span class="path-dot path-dot-big" aria-hidden="true"></span>)
  l << %(                    <div>)
  l << %(                        <p class="path-name">MiniExam #{n} <span class="path-where">in class</span></p>)
  l << %(                    </div>)
  l << %(                </li>)
  l << %(                <li class="path-step path-step-next" aria-hidden="true">)
  l << %(                    <span class="path-dot" aria-hidden="true"></span>)
  l << %(                    <div>)
  l << %(                        <p class="path-name">Part #{me['next']}</p>)
  l << %(                    </div>)
  l << %(                </li>)
  l << %(                    </ol>)
  l << %(                </div>)
  l << %(            </div>)
  l.join("\n")
end

def left_nav(current)
  l = []
  l << %(        <div class="left_div">)
  l << %(            <nav>)
  l << %(                <ul>)
  COURSE['brand'].each { |b| l << %(                    <a class="brand" href="#{COURSE['home']}">#{b}</a>) }
  l << %(                    <hr class="nav-hr">)
  COURSE['parts'].each_key do |p|
    if p == current
      l << %(                    <li><a class="active" href="">Part #{p}</a></li>)
    else
      l << %(                    <li><a href="part-#{p}.html">Part #{p}</a></li>)
    end
  end
  Array(COURSE['extra_nav']).each { |e| l << %(                    <li><a href="#{e['href']}">#{e['label']}</a></li>) }
  l << %(                </ul>)
  l << %(            </nav>)
  l << %(        </div>)
  l.join("\n")
end

def right_nav(part)
  l = []
  l << %(        <div class="right_div">)
  l << %(            <nav>)
  l << %(                <ul>)
  l << %(                    <span>Contents</span>)
  l << %(                    <hr class="nav-hr-right">)
  part['blocks'].each do |b|
    l << %(                    <li><a href="#part-#{b['id'].delete('.')}" class="nav-link-right">#{b['id']} | #{b['nav']}</a></li>)
  end
  if part['checkpoint']
    l << %(                    <li><a href="#miniexam" class="nav-link-right">MiniExam</a></li>)
  elsif part['checkpoint_raw']
    id = part['checkpoint_raw'][/id="([^"]*)"/, 1]
    label = part['checkpoint_raw'][%r{<h1 class="subtitle">([^<]*)</h1>}, 1]
    l << %(                    <li><a href="##{id}" class="nav-link-right">#{label}</a></li>)
  end
  l << %(                </ul>)
  l << %(            </nav>)
  l << %(        </div>)
  l.join("\n")
end

def render_part(num, part)
  blocks = part['blocks'].map { |b| block_html(b) }.join("\n")
  tail = if part['checkpoint']
           "\n" + checkpoint_html(part['checkpoint'])
         elsif part['checkpoint_raw']
           "\n\n            " + part['checkpoint_raw']
         else
           ''
         end
  <<~HTML
    <!DOCTYPE html>
    #{GENERATED}
    <html lang="en">

    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>#{COURSE['code']} | Part #{num}</title>

        <!-- MODULAR CSS -->
        <link rel="stylesheet" href="#{COURSE['stylesheet']}">

            <script>if (window.self !== window.top) document.documentElement.classList.add('embedded');</script>
    </head>


    <body>

        <div class="wrapper course-econ-0150">
    #{left_nav(num).chomp}

            <div class="content">

                <div class="description">
                    <h1 class="title title-tight">Part #{num} | #{part['title']}</h1>
                    <i class="subtitle-text">#{part['tagline']}</i>
                    <hr class="title-rule">
                    <p>
                        #{part['introduction']}
                    </p>
                </div>

    #{blocks.chomp}#{tail.chomp}

            </div>

    #{right_nav(part).chomp}
        </div> <!-- Close wrapper -->

        <!-- UNIFIED JAVASCRIPT (NO JQUERY) -->
        <script src="#{COURSE['script']}"></script>

    </body>

    </html>
  HTML
end

def render_index
  <<~HTML
    <!doctype html>
    #{GENERATED}
    <html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta http-equiv="refresh" content="0; url=#{COURSE['home']}">
        <link rel="canonical" href="#{COURSE['home']}">
        <title>#{COURSE['code']} | #{COURSE['title']}</title>
    </head>
    <body>
        <p><a href="#{COURSE['home']}">Continue to #{COURSE['code']}</a></p>
    </body>
    </html>
  HTML
end

COURSE['parts'].each do |num, part|
  ROOT.join("part-#{num}.html").write(render_part(num, part))
  puts "Generated part-#{num}.html"
end
ROOT.join('index.html').write(render_index)
puts 'Generated index.html'
