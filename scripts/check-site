#!/usr/bin/env ruby
# Read-only production checks for the ECON 0150 GitHub Pages repository.
require 'json'
require 'open3'
require 'pathname'
require 'set'
require 'uri'
require 'yaml'

ROOT = Pathname.new(__dir__).parent.realpath
GENERATED = '<!-- Generated from course-content.yml by scripts/build-course. Do not edit this file directly. -->'
PAGES = ['index.html', *(1..6).map { |number| "part-#{number}.html" }].freeze
STATIC_HOME = 'econ-0150.html'
EXPECTED_LOCAL_LINK_COUNT = 65
EXPECTED_ME_LINKS = (1..5).flat_map do |number|
  ["ME/ME_#{number}/ME_#{number}_Demo.pdf", "ME/ME_#{number}/ME_#{number}_Demo_sols.pdf"]
end.to_set.freeze
EXPECTED_ME_FILES = Set.new([
  'ME/ME_1/ME_1_Demo.md',
  'ME/ME_1/ME_1_Demo.pdf',
  'ME/ME_1/ME_1_Demo_sols.pdf',
  'ME/ME_2/ME_2_Demo.md',
  'ME/ME_2/ME_2_Demo.pdf',
  'ME/ME_2/ME_2_Demo_sols.pdf',
  'ME/ME_2/i/Q3.png',
  'ME/ME_2/i/Q3_blank.png',
  'ME/ME_2/i/Q4_blank.png',
  'ME/ME_2/i/Q5.png',
  'ME/ME_3/ME_3_Demo.md',
  'ME/ME_3/ME_3_Demo.pdf',
  'ME/ME_3/ME_3_Demo_sols.pdf',
  'ME/ME_4/ME_4_Demo.md',
  'ME/ME_4/ME_4_Demo.pdf',
  'ME/ME_4/ME_4_Demo_sols.pdf',
  'ME/ME_5/ME_5_Demo.md',
  'ME/ME_5/ME_5_Demo.pdf',
  'ME/ME_5/ME_5_Demo_sols.pdf'
]).freeze
TEXT_EXTENSIONS = Set.new(%w[
  .css .csv .htm .html .ipynb .js .json .lua .markdown .md .py .qmd
  .quarto_ipynb .r .rb .sas .sh .tex .toml .tsv .txt .yaml .yml
]).freeze
FORBIDDEN_PATH_MARKERS = [
  ['/', 'Users', '/'].join,
  ['C:', 'Users', ''].join('/'),
  ['..', 'ECON_0150'].join('/'),
  ['..', 'econ-0150'].join('/')
].freeze

errors = []

def collect_hrefs(value, hrefs, errors)
  case value
  when Hash
    value.each do |key, child|
      if key.to_s == 'href'
        if child.is_a?(String)
          hrefs << child
        else
          errors << "non-string href in course-content.yml: #{child.inspect}"
        end
      end
      collect_hrefs(child, hrefs, errors)
    end
  when Array
    value.each { |child| collect_hrefs(child, hrefs, errors) }
  when String
    value.scan(/\bhref\s*=\s*["']([^"']+)["']/i) { |match| hrefs << match.first }
  end
end

def git_paths(pathspec = nil)
  command = ['git', '-C', ROOT.to_s, 'ls-files', '-z']
  command.concat(['--', pathspec]) if pathspec
  stdout, stderr, status = Open3.capture3(*command)
  raise "git ls-files failed: #{stderr.strip}" unless status.success?

  stdout.split("\0").reject(&:empty?)
end

cname = ROOT.join('CNAME')
if !cname.file?
  errors << 'missing CNAME'
elsif cname.binread != "econ-0150.tayweid.io\n"
  errors << 'CNAME must contain exactly econ-0150.tayweid.io followed by one LF'
end

PAGES.each do |page|
  path = ROOT.join(page)
  if !path.file?
    errors << "missing generated page: #{page}"
  elsif !path.binread.include?(GENERATED)
    errors << "missing generated marker: #{page}"
  end
end

course_path = ROOT.join('course-content.yml')
hrefs = []
course = nil
begin
  course = YAML.safe_load(course_path.binread, permitted_classes: [], permitted_symbols: [], aliases: false)
  collect_hrefs(course, hrefs, errors)
  errors << "course home must remain #{STATIC_HOME}" unless course.is_a?(Hash) && course['home'] == STATIC_HOME
rescue StandardError => e
  errors << "cannot parse course-content.yml: #{e.message}"
end

local_links = Set.new
hrefs.each do |href|
  next if href.start_with?('#')
  if (scheme = href[/\A([A-Za-z][A-Za-z0-9+.-]*):/, 1])
    next if %w[http https].include?(scheme.downcase)

    errors << "unsupported link scheme: #{href.inspect}"
    next
  end

  encoded_path = href.split(/[?#]/, 2).first
  begin
    decoded_path = URI::DEFAULT_PARSER.unescape(encoded_path)
  rescue ArgumentError => e
    errors << "invalid link encoding #{href.inspect}: #{e.message}"
    next
  end
  next unless decoded_path.downcase.end_with?('.html', '.pdf')

  if decoded_path.empty? || Pathname.new(decoded_path).absolute? || decoded_path.start_with?('//') || decoded_path.include?('\\') || decoded_path.match?(/\A[A-Za-z]:/) || decoded_path.split('/').include?('..')
    errors << "unsafe local link: #{href.inspect}"
    next
  end

  local_links << decoded_path
  target = ROOT.join(decoded_path)
  errors << "missing or empty linked artifact: #{decoded_path}" unless target.file? && target.size.positive?
end

if local_links.length != EXPECTED_LOCAL_LINK_COUNT
  errors << "course-content.yml has #{local_links.length} unique local HTML/PDF links; expected #{EXPECTED_LOCAL_LINK_COUNT}"
end

actual_me_links = local_links.select { |path| path.start_with?('ME/') }.to_set
unless actual_me_links == EXPECTED_ME_LINKS
  errors << "MiniExam PDF links differ: missing=#{(EXPECTED_ME_LINKS - actual_me_links).to_a.sort.inspect} extra=#{(actual_me_links - EXPECTED_ME_LINKS).to_a.sort.inspect}"
end

tracked_paths = []
begin
  tracked_paths = git_paths
  tracked_set = tracked_paths.to_set
  local_links.each do |path|
    errors << "linked artifact is not tracked: #{path}" unless tracked_set.include?(path)
  end
  home_path = ROOT.join(STATIC_HOME)
  errors << "missing or empty static home: #{STATIC_HOME}" unless home_path.file? && home_path.size.positive?
  errors << "static home is not tracked: #{STATIC_HOME}" unless tracked_set.include?(STATIC_HOME)
  tracked_me_files = git_paths('ME').to_set
  unless tracked_me_files == EXPECTED_ME_FILES
    errors << "public MiniExam allowlist differs: missing=#{(EXPECTED_ME_FILES - tracked_me_files).to_a.sort.inspect} extra=#{(tracked_me_files - EXPECTED_ME_FILES).to_a.sort.inspect}"
  end
  EXPECTED_ME_FILES.each do |path|
    errors << "missing public MiniExam demo file: #{path}" unless ROOT.join(path).file?
  end
rescue StandardError => e
  errors << e.message
end

notebooks = []
tracked_paths.each do |relative|
  path = ROOT.join(relative)
  extension = path.extname.downcase
  text_source = TEXT_EXTENSIONS.include?(extension) || (extension.empty? && relative.start_with?('scripts/'))
  if text_source && path.file?
    content = path.binread
    unless content.include?("\0")
      text = content.encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
      text.each_line.with_index(1) do |line, line_number|
        marker = FORBIDDEN_PATH_MARKERS.find { |candidate| line.include?(candidate) }
        if marker
          errors << "machine/sibling path in #{relative}:#{line_number}: #{marker}"
        end
      end
    end
  end

  next unless ['.ipynb', '.quarto_ipynb'].include?(extension)

  notebooks << relative
  begin
    JSON.parse(path.binread)
  rescue JSON::ParserError => e
    errors << "invalid notebook JSON: #{relative}: #{e.message.lines.first.to_s.strip}"
  end
end

if errors.empty?
  puts "OK: #{PAGES.length} pages, #{local_links.length} linked artifacts, #{EXPECTED_ME_FILES.length} MiniExam demo files, #{notebooks.length} notebooks"
else
  errors.each { |error| warn "ERROR: #{error}" }
  warn "FAILED: #{errors.length} problem#{errors.length == 1 ? '' : 's'}"
  exit 1
end
